# Copy to agent/.env. Used by the demo and by `adk web` (run from agent/).
# The agent's own model runs on Vertex AI with your gcloud credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ltm-memory-server
GOOGLE_CLOUD_LOCATION=global
AGENT_MODEL=gemini-3.5-flash

# The deployed memory server (deploy/deploy.sh url) plus /mcp.
MEMORY_MCP_URL=https://memory-mcp-XXXXXXXX.us-central1.run.app/mcp

# Auth0: a Native application with the Device Code grant enabled (and, for the
# scripted demo users, the Password grant). Not secret: domain, client id, audience.
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=your-native-app-client-id
AUTH0_AUDIENCE=https://memory-mcp.example

# Optional: a bearer token to use as-is (e.g. for `adk web`). Never commit one.
MEMORY_MCP_TOKEN=
