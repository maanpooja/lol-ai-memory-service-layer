# Copy to .env and fill in PROJECT_ID.
PROJECT_ID=your-gcp-project-id
DE_LOCATION=global
DATA_STORE_ID=memories
COLLECTION=default_collection

# The search app that setup_datastore.py creates on top of the data store.
# Required: documents are not indexed, and search returns nothing, without it.
ENGINE_ID=memories-app

# --- MCP server (Part 2) ---
# Only "dev" exists: a STUB identity, not for production.
AUTH_MODE=dev
DEV_TENANT_ID=dev-tenant
DEV_USER_ID=dev-user
DEV_APP_ID=dev-app
# HTTP transport only. When true, X-Dev-Tenant / X-Dev-User / X-Dev-App request
# headers override the identity above. Local testing only.
DEV_ALLOW_HEADER_OVERRIDE=false

# --- Part 3: DLP + Gemini ---
# gemini-2.5-flash retires on Vertex AI on 2026-10-20, so the default is gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global
# MINIMAL, LOW, MEDIUM or HIGH. MINIMAL keeps each call at about 1-2s.
GEMINI_THINKING_LEVEL=MINIMAL
DLP_LOCATION=global
MAX_INPUT_CHARS=8000
MAX_FACTS_PER_CALL=10
MIN_CONFIDENCE=0.6
# Topics never stored. Comma separated.
BLOCKED_CATEGORIES=health,financial,credentials,salary,performance_review,grievance,legal,government_id,biometric,religion,political,sexual_orientation,minors_data
# Days until a new memory expires, per category. 0 = never.
TTL_DAYS_PREFERENCE=180
TTL_DAYS_PROFILE=365
TTL_DAYS_DEVICE=365
TTL_DAYS_PROJECT=30
TTL_DAYS_GENERAL=90
