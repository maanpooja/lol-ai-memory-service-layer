# Copy to demo_agent/.env. adk web loads it for demo_agent/memory_agent.
# (If demo_agent/.env is missing, ADK keeps walking up and would load memory-mcp/.env,
#  the SERVER's settings. Always create this file.)

# The agent's own model runs on Vertex AI with your gcloud ADC login.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ltm-memory-server
# gemini-3.5-flash only generates via the global endpoint (us-central1 returns 404).
GOOGLE_CLOUD_LOCATION=global
DEMO_AGENT_MODEL=gemini-3.5-flash

# The deployed memory server, ending in /mcp.
MEMORY_MCP_URL=https://memory-mcp-140715294513.us-central1.run.app/mcp

# Demo identity. Must match a token cached by scripts/demo_login.py --user <DEMO_USER_ID>.
# The server's tenant is fixed by its deployment (TENANT_ID=demo-tenant).
DEMO_TENANT_ID=demo-tenant
DEMO_USER_ID=alice

# Auth0 (not secret), used by scripts/demo_login.py.
AUTH0_DOMAIN=memory-mcp-demo.us.auth0.com
AUTH0_CLIENT_ID=BmrlMoxCchsZsF9Hqj6eKCrIkju54PpY
AUTH0_AUDIENCE=https://memory-mcp.example
