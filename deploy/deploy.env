# Copy to deploy/deploy.env. Not secret: issuer and audience are public values.
PROJECT_ID=ltm-memory-server
REGION=us-central1
SERVICE=memory-mcp
DATA_STORE_ID=memories
ENGINE_ID=memories-app
GEMINI_MODEL=gemini-3.5-flash
# Auth0: issuer is https://YOUR_TENANT.auth0.com/ (keep the trailing slash),
# audience is the Identifier of the Auth0 API you created for memory-mcp.
OIDC_ISSUER=https://memory-mcp-demo.us.auth0.com/
OIDC_AUDIENCE=https://memory-mcp.example
# One tenant per deployment.
TENANT_ID=demo-tenant
BQ_LOCATION=US
# Public URL of the service (printed by the first deploy). Enables OAuth metadata.
SERVER_URL=https://memory-mcp-140715294513.us-central1.run.app
# ShiftMate web app (deploy/shiftmate.sh). Public values, not secrets.
AUTH0_DOMAIN=memory-mcp-demo.us.auth0.com
AUTH0_SPA_CLIENT_ID=jwQTMZN9TdJuYMqp6qcDhEnpRqiGdkza
